# Copy to .env.vercel.local, replace placeholders, then import that file in Vercel.
# Only variables prefixed with VITE_ are exposed to browser code.

# Frontend (Vercel build-time)
VITE_API_BASE_URL=/api/v1
VITE_SUPABASE_URL=https://ztjxdjfhsypdyrwoifyd.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Backend (Vercel server runtime only; NEVER add a VITE_ prefix)
SUPABASE_URL=https://ztjxdjfhsypdyrwoifyd.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=ROTATE_AND_SET_SUPABASE_SERVICE_ROLE_KEY
WEB_APP_URL=https://alsera.vercel.app
CORS_ORIGIN=https://alsera.vercel.app
SAFEPAY_PUBLIC_KEY=SET_SANDBOX_PUBLIC_KEY
SAFEPAY_SECRET_KEY=ROTATE_AND_SET_SANDBOX_SECRET_KEY
SAFEPAY_WEBHOOK_SECRET=SET_AFTER_CREATING_SAFEPAY_WEBHOOK
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_BASE_URL=https://sandbox.api.getsafepay.com
