{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build --workspace @alsera/web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
